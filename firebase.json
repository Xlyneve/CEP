{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "node_modules/**",
      "RNCNP1.html",
      ".github/**",
      ".gitignore",
      "firestore.rules",
      "storage.rules",
      "SECURITY-SETUP.md",
      "THEME-SCOPE.md",
      ".env*",
      "*.log",
      "*.pem",
      "*.key",
      "*service-account*.json"
    ],
    "cleanUrls": false,
    "trailingSlash": false
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
